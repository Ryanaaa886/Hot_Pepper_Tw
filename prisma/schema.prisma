generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SHOP_OWNER
  STYLIST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  name         String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedShops     Shop[]    @relation("ShopOwner")
  stylistProfile Stylist?  @relation("UserStylist")
  bookings       Booking[] @relation("CustomerBookings")
}

model Shop {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  address     String
  city        String
  district    String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stylists Stylist[]
  services Service[]
  bookings Booking[]

  @@index([city, district])
}

model Stylist {
  id                String   @id @default(cuid())
  shopId            String
  userId            String?  @unique
  displayName       String
  bio               String?
  yearsOfExperience Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User?            @relation("UserStylist", fields: [userId], references: [id], onDelete: SetNull)
  services ServiceStylist[]
  bookings Booking[]

  @@index([shopId, isActive])
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  title       String
  category    String
  description String?
  durationMin Int
  price       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stylists ServiceStylist[]
  bookings Booking[]

  @@index([shopId, category, isActive])
}

model ServiceStylist {
  serviceId String
  stylistId String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@id([serviceId, stylistId])
}

model Booking {
  id           String        @id @default(cuid())
  customerId   String
  shopId       String
  stylistId    String
  serviceId    String
  startAt      DateTime
  endAt        DateTime
  status       BookingStatus @default(PENDING)
  totalPrice   Int
  note         String?
  cancelReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer User    @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  stylist  Stylist @relation(fields: [stylistId], references: [id], onDelete: Restrict)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([stylistId, startAt])
  @@index([shopId, startAt])
  @@index([stylistId, startAt])
  @@index([customerId, startAt])
}
